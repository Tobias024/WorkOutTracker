# Supabase — obtené estos valores en tu proyecto (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sólo para el script de seed (Settings → API → service_role). NO exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL pública de la app (para links de invitación / compartir)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificaciones push (Web Push / VAPID).
# Generá el par con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:vos@tudominio.com

# Secreto para proteger el endpoint del cron (Vercel lo manda como
# Authorization: Bearer <CRON_SECRET>). Poné cualquier string largo y random.
CRON_SECRET=un-string-largo-y-random
